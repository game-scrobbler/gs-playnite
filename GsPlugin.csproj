<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>GsPlugin</RootNamespace>
    <AssemblyName>GsPlugin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Version managed by release-please -->
    <!-- x-release-please-start-version -->
    <Version>3.0.0</Version>
    <!-- x-release-please-end -->
    <AssemblyTitle>Game Scrobbler</AssemblyTitle>
    <Company>GameScrobbler</Company>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <!-- Allow test project to access internal members (constructors, helpers) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GsPlugin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The project sits at the repository root, so the SDK's **/*.cs glob sweeps in every
       directory beside it. Exclude the ones that are not ours:
         - GsPlugin.Tests: test sources would land in GenerateTemporaryTargetAssembly (WPF
           XAML Pass2) and be compiled into the plugin.
         - powershell-yaml: CI checks this third-party module out at the repository root for
           the manifest tests and the release manifest update. It ships C# sources, and
           compiling (and format-checking) someone else's code fails the build on our own
           analyzer settings.
         - tools: vendored binaries, never sources. -->
  <ItemGroup>
    <Compile Remove="GsPlugin.Tests\**\*.cs" />
    <Compile Remove="powershell-yaml\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Playnite.SDK" Version="11.0.0-alpha14" />
    <PackageReference Include="Sentry" Version="6.*" />
    <PackageReference Include="PostHog" Version="2.4.0" />
    <!-- CommunityToolkit.Mvvm provides ObservableObject for settings view model/data -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <!-- WebView2 replaces CefSharp for the embedded dashboard browser -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <!-- Same rule set as main (.editorconfig + stylecop.json), build-time only. main pins 1.1.118,
         which predates C# 12 and reports collection expressions (`return [x];`) as SA1010
         violations; 1.2.0-beta.556 is the release line that parses modern C#. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="extension.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Localization\*.ftl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="readme.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
