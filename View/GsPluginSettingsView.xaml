<!-- Plugin Settings View for GS (Game Scrobbler) Plugin -->
<UserControl x:Class="GsPlugin.View.GsPluginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GsPlugin.View"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="620">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Brand accent color — intentionally fixed, not theme-driven -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5B9CF6"/>

        <!-- Severity palette shared by every status row, badge and warning strip -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFA500"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="DangerAccentBrush" Color="#E53E3E"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#FC5656"/>

        <!-- Section header label -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Left accent bar for section headers — brand color, always fixed -->
        <Style x:Key="AccentBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!--
            Card section chrome: themed panel, left accent bar and header label.
            Only the chrome lives in the ControlTemplate. Each section supplies its
            own body as Content, so every x:Name inside a card stays in the page
            namescope and remains reachable from the code-behind.
            Tag carries the accent bar brush, Foreground the header text brush.
        -->
        <Style x:Key="CardSectionStyle" TargetType="HeaderedContentControl">
            <Setter Property="Background" Value="{DynamicResource GridItemBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Tag" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Rectangle Style="{StaticResource AccentBarStyle}"
                                               Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </StackPanel>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger zone variant: identical chrome, red border, accent bar and title -->
        <Style x:Key="DangerCardSectionStyle" TargetType="HeaderedContentControl" BasedOn="{StaticResource CardSectionStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource DangerAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerAccentBrush}"/>
            <Setter Property="Tag" Value="{StaticResource DangerAccentBrush}"/>
        </Style>

        <!-- Bordered inset box used for code blocks, badges and status strips -->
        <Style x:Key="InsetBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Leading glyph of a status row (check mark, warning sign) -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Text that follows a status glyph -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Muted helper text -->
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- TextBox that inherits Playnite theme — BasedOn preserves the theme's ControlTemplate
             so the TextBox stays editable across all Playnite themes -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Primary accent button — brand color is intentional -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="110"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7DB3F8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource NormalBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Destructive action button: same shape as primary, red palette -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerAccentBrush}"/>
            <Setter Property="MinWidth" Value="160"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary outline button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="160"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridItemBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox inherits Playnite theme text color -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">

            <!-- ─────────────────────────────────────────
                 SECTION 1 — INSTALLATION ID
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginInstallIdSectionTitle}">
                <StackPanel>

                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,8"
                               Text="{DynamicResource LOCGsPluginInstallIdDescription}"/>

                    <!-- Code-block styled ID display -->
                    <Border Style="{StaticResource InsetBoxStyle}"
                            Padding="10,8">
                        <TextBlock x:Name="IDTextBlock"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   Cursor="Hand"
                                   ToolTip="{DynamicResource LOCGsPluginInstallIdCopyTooltip}"
                                   MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"/>
                    </Border>

                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,8"
                               Text="{DynamicResource LOCGsPluginInstallIdCopyHint}"/>

                    <!-- Install token status indicator -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="InstallTokenStatusTextBlock"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 2 — THEME & DASHBOARD
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginThemeSectionTitle}">
                <StackPanel>

                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,8"
                               Text="{DynamicResource LOCGsPluginThemeDescription}"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              Background="{DynamicResource ComboboxBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource NormalBorderBrush}"
                              BorderThickness="1"
                              Padding="8,5"
                              FontSize="12"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding Settings.Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Beta channel toggle (early feature access, grouped with theme) -->
                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginNewDashboardExperienceLabel}"
                              ToolTip="{DynamicResource LOCGsPluginNewDashboardExperienceTooltip}"
                              IsChecked="{Binding Settings.NewDashboardExperience, Mode=TwoWay}"
                              Margin="0,0,0,0"/>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 3 — ACCOUNT LINKING
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginAccountLinkingSectionTitle}">
                <StackPanel>

                    <!-- Hint with hyperlink -->
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextBrushDarker}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource LOCGsPluginAccountLinkingHintPrefix}"/>
                        <Hyperlink NavigateUri="https://gamescrobbler.com?utm_source=playnite_plugin&amp;utm_medium=settings_page&amp;utm_campaign=account_linking&amp;utm_content=hint_text"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource AccentBrush}">
                            <Run Text="gamescrobbler.com"/>
                        </Hyperlink>
                        <Run Text="{DynamicResource LOCGsPluginAccountLinkingHintSuffix}"/>
                    </TextBlock>

                    <!-- Connection status badge -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LOCGsPluginStatusLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextBrushDarker}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Style="{StaticResource InsetBoxStyle}"
                                CornerRadius="10"
                                Padding="10,4">
                            <TextBlock x:Name="ConnectionStatusTextBlock"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Disconnect button (visible only when linked) -->
                    <Button x:Name="DisconnectAccountButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource LOCGsPluginDisconnectAccountButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Visibility="Collapsed"
                            Click="DisconnectAccount_Click"
                            ToolTip="{DynamicResource LOCGsPluginDisconnectAccountTooltip}"/>

                    <!-- Open website button -->
                    <Button x:Name="OpenWebsiteToLinkButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource LOCGsPluginLinkOnWebsiteButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Click="OpenWebsiteToLink_Click"
                            ToolTip="{DynamicResource LOCGsPluginOpenWebsiteToLinkTooltip}"/>

                    <!-- Separator: lines + label -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Height="1"
                                Background="{DynamicResource NormalBorderBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="ManualTokenSeparator"
                                   Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextBrushDarker}"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource LOCGsPluginManualTokenSeparator}"/>
                        <Border Grid.Column="2"
                                Height="1"
                                Background="{DynamicResource NormalBorderBrush}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Token input row -->
                    <Grid x:Name="LinkingControlsGrid" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="TokenTextBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding Settings.LinkToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 ToolTip="{DynamicResource LOCGsPluginTokenInputTooltip}"/>

                        <Button Grid.Column="1"
                                x:Name="LinkAccountButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource LOCGsPluginLinkAccountButton}"
                                Click="LinkAccount_Click"/>
                    </Grid>

                    <!-- Token expiry countdown, hidden while there is nothing to say -->
                    <TextBlock Foreground="{DynamicResource TextBrushDarker}"
                               FontSize="11"
                               Margin="0,0,0,4"
                               Text="{Binding Settings.TokenCountdown}"
                               Visibility="{Binding Settings.TokenCountdown, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <!-- Link status message, hidden while there is nothing to say -->
                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.LinkStatusMessage}"
                               Visibility="{Binding Settings.LinkStatusMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 4 — SYNC SETTINGS
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginSyncSettingsSectionTitle}">
                <StackPanel>

                    <!-- Achievement sync -->
                    <StackPanel Margin="0,0,0,4">
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{DynamicResource LOCGsPluginSyncAchievementsLabel}"
                                  ToolTip="{DynamicResource LOCGsPluginSyncAchievementsTooltip}"
                                  IsChecked="{Binding Settings.SyncAchievements, Mode=TwoWay}"
                                  Margin="0,0,0,6"/>

                        <!-- Achievement provider(s) detected -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0,0,4"
                                    Visibility="{Binding IsAnyAchievementProviderInstalled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource StatusIconStyle}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="&#10003;"/>
                            <TextBlock Style="{StaticResource StatusTextStyle}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding AchievementProviderStatusText}"/>
                        </StackPanel>

                        <!-- No achievement provider installed -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0,0,0"
                                    Visibility="{Binding IsAllAchievementProvidersMissing,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource StatusIconStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="&#9888;"/>
                            <TextBlock Style="{StaticResource StatusTextStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="{DynamicResource LOCGsPluginAchievementProviderMissingWarning}"/>
                                <Run Text=" "/>
                                <Hyperlink NavigateUri="https://playnite.link/addons.html"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{StaticResource AccentBrush}">
                                    <Run Text="{DynamicResource LOCGsPluginAchievementProviderInstallLink}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Library sync status -->
                    <Border Style="{StaticResource InsetBoxStyle}"
                            Padding="10,6"
                            Margin="0,8,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource LOCGsPluginLibrarySyncLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LastSyncStatusTextBlock"
                                       Style="{StaticResource StatusTextStyle}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending scrobbles indicator — only visible when queue is non-empty -->
                    <Border x:Name="PendingScrobblesBorder"
                            Style="{StaticResource InsetBoxStyle}"
                            BorderBrush="{StaticResource WarningBrush}"
                            Padding="10,6"
                            Margin="0,4,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatusIconStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="&#9888;"/>
                            <TextBlock x:Name="PendingScrobblesTextBlock"
                                       Style="{StaticResource StatusTextStyle}"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Dropped scrobbles indicator — only visible when scrobbles were lost -->
                    <Border x:Name="DroppedScrobblesBorder"
                            Style="{StaticResource InsetBoxStyle}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Padding="10,6"
                            Margin="0,4,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatusIconStyle}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="&#9888;"/>
                            <TextBlock x:Name="DroppedScrobblesTextBlock"
                                       Style="{StaticResource StatusTextStyle}"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 5 — NOTIFICATIONS
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginNotificationsSectionTitle}">
                <StackPanel>

                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginShowUpdateNotificationsLabel}"
                              ToolTip="{DynamicResource LOCGsPluginShowUpdateNotificationsTooltip}"
                              IsChecked="{Binding Settings.ShowUpdateNotifications, Mode=TwoWay}"/>

                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginShowImportantNotificationsLabel}"
                              ToolTip="{DynamicResource LOCGsPluginShowImportantNotificationsTooltip}"
                              IsChecked="{Binding Settings.ShowImportantNotifications, Mode=TwoWay}"/>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 6 — PRIVACY CONTROLS
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource CardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginPrivacySectionTitle}">
                <StackPanel>

                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginDisableSentryLabel}"
                              ToolTip="{DynamicResource LOCGsPluginDisableSentryTooltip}"
                              IsChecked="{Binding Settings.DisableSentry, Mode=TwoWay}"/>

                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginDisablePostHogLabel}"
                              ToolTip="{DynamicResource LOCGsPluginDisablePostHogTooltip}"
                              IsChecked="{Binding Settings.DisablePostHog, Mode=TwoWay}"/>

                    <CheckBox x:Name="DisableScrobblingCheckBox"
                              Style="{StaticResource CheckBoxStyle}"
                              Content="{DynamicResource LOCGsPluginDisableScrobblingLabel}"
                              ToolTip="{DynamicResource LOCGsPluginDisableScrobblingTooltip}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Settings.DisableScrobbling, Mode=TwoWay}"/>

                    <!-- Warning when scrobbling is disabled -->
                    <StackPanel Orientation="Horizontal"
                                Margin="20,0,0,0"
                                Visibility="{Binding Settings.DisableScrobbling,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource StatusIconStyle}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   Text="&#9888;"/>
                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource LOCGsPluginScrobblingDisabledWarning}"/>
                    </StackPanel>

                </StackPanel>
            </HeaderedContentControl>

            <!-- ─────────────────────────────────────────
                 SECTION 7 — DANGER ZONE
            ───────────────────────────────────────── -->
            <HeaderedContentControl Style="{StaticResource DangerCardSectionStyle}"
                                    Header="{DynamicResource LOCGsPluginDangerZoneSectionTitle}">
                <StackPanel>

                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="{DynamicResource LOCGsPluginDangerZoneWarning}"/>

                    <Button x:Name="DeleteMyDataButton"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource LOCGsPluginDeleteMyDataButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Click="DeleteMyData_Click"/>

                    <Button x:Name="OptBackInButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource LOCGsPluginOptBackInButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Visibility="Collapsed"
                            Click="OptBackIn_Click"
                            ToolTip="{DynamicResource LOCGsPluginOptBackInTooltip}"/>

                    <!-- Deletion status message, hidden while there is nothing to say -->
                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.DeleteStatusMessage}"
                               Visibility="{Binding Settings.DeleteStatusMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>

                </StackPanel>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
