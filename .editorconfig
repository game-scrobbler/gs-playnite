# EditorConfig: https://editorconfig.org
# .NET options: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options
#
# Comments must sit on their own line: the EditorConfig spec has no inline
# comments, so "key = value  # note" makes the note part of the value for any
# tool other than Roslyn.
root = true

#### Core EditorConfig options ####

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,config,nuspec,resx,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.sln]
indent_style = tab

#### C# ####

[*.cs]

# Using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:silent

# New lines and braces
csharp_new_line_before_open_brace = none
csharp_preserve_single_line_statements = true
csharp_indent_labels = one_less_than_current
dotnet_style_operator_placement_when_wrapping = beginning_of_line
csharp_style_allow_multiple_blank_lines_experimental = false
dotnet_style_allow_multiple_blank_lines_experimental = false:silent
dotnet_style_allow_statement_immediately_after_block_experimental = true:silent
csharp_style_allow_embedded_statements_on_same_line_experimental = true:silent
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = true:silent
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = true:silent
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = true:silent
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = true:silent

# Code block preferences
csharp_prefer_braces = true:silent
csharp_style_namespace_declarations = block_scoped:silent

# Expression-bodied members
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = false:silent
csharp_style_expression_bodied_local_functions = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent

# Expression preferences
csharp_style_prefer_method_group_conversion = true:silent
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:silent

#### Naming ####
# Suggestion only: bare "dotnet format" applies fixes at warning and above, and
# a naming fix is a rename.

dotnet_naming_rule.interfaces_should_begin_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_begin_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case

# Private static fields are deliberately unconstrained: the codebase uses both
# _camelCase and PascalCase for them. Roslyn ranks a rule by accessibility before
# modifiers, so the static rule also exempts private consts, and the underscore
# rule only decides private instance fields.
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case

dotnet_naming_rule.static_private_fields_are_unconstrained.severity = none
dotnet_naming_rule.static_private_fields_are_unconstrained.symbols = static_private_fields
dotnet_naming_rule.static_private_fields_are_unconstrained.style = pascal_case

dotnet_naming_rule.parameters_and_locals_should_be_camel_case.severity = suggestion
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.style = camel_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = *

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.static_private_fields.applicable_kinds = field
dotnet_naming_symbols.static_private_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_private_fields.required_modifiers = static

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

#### Analyzer severities ####
# Rules at warning are auto-fixed by scripts/format-code.ps1 and enforced by the
# pre-commit hook, because bare "dotnet format" applies analyzer fixes.

# Mark members as static
dotnet_diagnostic.CA1822.severity = error

#### StyleCop.Analyzers ####

# Off: contradicts the established conventions of this codebase.
# this. prefix
dotnet_diagnostic.SA1101.severity = none
# regions
dotnet_diagnostic.SA1124.severity = none
# aligned trailing comments
dotnet_diagnostic.SA1025.severity = none
# string.Empty over ""
dotnet_diagnostic.SA1122.severity = none
# generic constraints on their own line
dotnet_diagnostic.SA1127.severity = none
# constructor initializer on its own line
dotnet_diagnostic.SA1128.severity = none
# _camelCase private fields
dotnet_diagnostic.SA1309.severity = none
# _camelCase static readonly fields
dotnet_diagnostic.SA1311.severity = none
# trailing commas
dotnet_diagnostic.SA1413.severity = none
# blank line between every element
dotnet_diagnostic.SA1516.severity = none
# XML doc generation is intentionally off
dotnet_diagnostic.SA0001.severity = none

# Off: conflicts with csharp_new_line_before_open_brace = none
dotnet_diagnostic.SA1500.severity = none

# Off: conflicts with csharp_preserve_single_line_statements = true
dotnet_diagnostic.SA1107.severity = none
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1502.severity = none

# Off: the documentation fixers write placeholder text into doc comments.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none

# Off: DTO property names are the snake_case/camelCase JSON wire contract.
dotnet_diagnostic.SA1300.severity = none

# Off: Api/Dtos.cs deliberately holds every DTO at namespace level.
dotnet_diagnostic.SA1402.severity = none

# Suggestion: worth following in new code, but no safe bulk fix exists.
# parenthesis placement and spacing
dotnet_diagnostic.SA1009.severity = suggestion
dotnet_diagnostic.SA1111.severity = suggestion
# parameter wrapping; SA1115 also conflicts with SA1515 when a comment sits between arguments
dotnet_diagnostic.SA1115.severity = suggestion
dotnet_diagnostic.SA1116.severity = suggestion
dotnet_diagnostic.SA1117.severity = suggestion
dotnet_diagnostic.SA1118.severity = suggestion
# member ordering
dotnet_diagnostic.SA1201.severity = suggestion
dotnet_diagnostic.SA1202.severity = suggestion
dotnet_diagnostic.SA1203.severity = suggestion
dotnet_diagnostic.SA1204.severity = suggestion
dotnet_diagnostic.SA1214.severity = suggestion
# non-private fields
dotnet_diagnostic.SA1401.severity = suggestion
# omitted braces; matches csharp_prefer_braces = true:silent
dotnet_diagnostic.SA1503.severity = suggestion
